      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nstaticData.seen = staticData.seen || {};\n\nconst now = Date.now();\n\nfor (const email of Object.keys(staticData.seen)) {\n  if (now - staticData.seen[email] > 3600000) {\n    delete staticData.seen[email];\n  }\n}\n\nconst disposableDomains = [\n  'mailinator.com',\n  'guerrillamail.com',\n  '10minutemail.com',\n  'tempmail.com',\n  'temp-mail.org',\n  'yopmail.com',\n  'trashmail.com',\n  'sharklasers.com',\n  'getnada.com',\n  'throwawaymail.com',\n  'dispostable.com',\n  'maildrop.cc',\n  'fakeinbox.com'\n];\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n\n  const isWebhook =\n    j.body !== undefined &&\n    j.body !== null &&\n    typeof j.body === 'object' &&\n    !Array.isArray(j.body);\n\n  const src = isWebhook ? j.body : j;\n\n  const body = {\n    firstName: String(src.firstName ?? src['First Name'] ?? '').trim(),\n    lastName: String(src.lastName ?? src['Last Name'] ?? '').trim(),\n    email: String(src.email ?? src['Work Email'] ?? '').trim().toLowerCase(),\n    company: String(src.company ?? src['Company'] ?? '').trim(),\n    message: String(src.message ?? src['How can we help?'] ?? '').trim(),\n    source: isWebhook\n      ? String(src.source ?? 'webhook').trim()\n      : 'hosted-form'\n  };\n\n  const reasons = [];\n\n  // Form-specific honeypot check\n  if (\n    !isWebhook &&\n    String(src.website ?? src['Website (leave empty)'] ?? '').trim() !== ''\n  ) {\n    reasons.push('honeypot field filled');\n  }\n\n  // Shared checks for BOTH form and webhook\n  const domain = body.email.split('@')[1] || '';\n\n  if (disposableDomains.includes(domain)) {\n    reasons.push('disposable email domain');\n  }\n\n  if (body.message.length < 10) {\n    reasons.push('message too short');\n  }\n\n  if (body.message.length > 3000) {\n    reasons.push('message too long');\n  }\n\n  const links = (body.message.match(/https?:|www[.]/gi) || []).length;\n\n  if (links > 1) {\n    reasons.push('too many links');\n  }\n\n  if (\n    /[bcdfghjklmnpqrstvwxyz]{7,}/i.test(\n      body.firstName + body.lastName + body.company\n    )\n  ) {\n    reasons.push('possible gibberish name or company');\n  }\n\n  if (body.firstName && body.firstName === body.lastName) {\n    reasons.push('first and last name identical');\n  }\n\n  // Shared duplicate check for BOTH input channels\n  if (body.email && staticData.seen[body.email]) {\n    if (now - staticData.seen[body.email] < 600000) {\n      reasons.push('duplicate submission within 10 minutes');\n    }\n  }\n\n  if (body.email) {\n    staticData.seen[body.email] = now;\n  }\n\n  output.push({\n    json: {\n      body,\n      channel: isWebhook ? 'webhook' : 'form',\n      is_spam: reasons.length > 0,\n      spam_reason: reasons.join('; ')\n    }\n  });\n}\n\nreturn output;\n"
      },
