    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const body = item.json.body;\n\n  const email =\n    typeof body?.email === \"string\"\n      ? body.email.trim()\n      : \"\";\n\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n    throw new Error(\n      \"Invalid lead input: a valid email address is required.\"\n    );\n  }\n\n  body.email = email;\n\n  for (const field of [\n    \"firstName\",\n    \"lastName\",\n    \"company\",\n    \"message\",\n    \"source\"\n  ]) {\n    if (\n      body[field] !== undefined &&\n      typeof body[field] !== \"string\"\n    ) {\n      throw new Error(\n        `Invalid lead input: ${field} must be text.`\n      );\n    }\n\n    if (typeof body[field] === \"string\") {\n      body[field] = body[field].trim();\n    }\n  }\n}\n\nreturn items;"
      },
