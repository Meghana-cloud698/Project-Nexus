    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-flash-lite-latest",
          "mode": "list",
          "cachedResultName": "Gemini Flash-Lite Latest"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a lead qualification assistant for Project Nexus.\n\nAnalyze the following lead and classify it as hot, warm, cold, or spam.\n\nLead information:\nFirst Name: {{ $('validate lead input').item.json.body.firstName }}\nLast Name: {{ $('validate lead input').item.json.body.lastName }}\nEmail: {{ $('validate lead input').item.json.body.email }}\nCompany: {{ $('validate lead input').item.json.body.company }}\nMessage: {{ $('validate lead input').item.json.body.message }}\nSource: {{ $('validate lead input').item.json.body.source }}\n\nReturn ONLY valid JSON. Do not use markdown or code fences.\n\nUse exactly this format:\n{\n  \"lead_score\": \"hot\",\n  \"reason\": \"short explanation\",\n  \"escalation\": false\n}\n\nRules:\n- hot = strong buying intent, urgent need, or clear request for a product/demo/pricing\n- warm = genuine interest but no strong buying signal yet\n- cold = vague, low-intent, or informational inquiry\n- spam = fake, gibberish, bot-written, promotional/SEO/crypto/link-spam, abusive, or obviously invalid submissions (nonsense names, random characters, unrelated advertising)\n- escalation = true only when the lead shows strong buying intent or explicitly requests urgent sales assistance"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "8d1b0889-507f-467e-89e3-35d412ba0f8d",
      "name": "Message a model",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        80,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "googlePalmApi": {
          "id": "BpnEn1HSHVlqyeFL",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n\nconst items = $input.all();\n\nfor (const item of items) {\n  const geminiParts = item.json.content?.parts ?? item.json.candidates?.[0]?.content?.parts ?? [];\n  const geminiText = geminiParts.filter(p => typeof p.text === \"string\" && !p.thought).map(p => p.text).join(\"\");\n  const raw = item.json.merged_response || geminiText;\n\n  let result;\n  let valid = false;\n\n  try {\n    if (typeof raw !== \"string\" || !raw.trim()) {\n      throw new Error(\"Empty AI response\");\n    }\n\n    const cleanText = raw\n      .replace(/```json/gi, \"\")\n      .replace(/```/g, \"\")\n      .trim();\n\n    result = JSON.parse(cleanText);\n\n    const score = String(result.lead_score ?? \"\")\n      .trim()\n      .toLowerCase();\n\n    if (\n      [\"hot\", \"warm\", \"cold\", \"spam\"].includes(score) &&\n      typeof result.reason === \"string\" &&\n      result.reason.trim().length > 0 &&\n      typeof result.escalation === \"boolean\"\n    ) {\n      valid = true;\n      item.json.lead_score = score;\n      item.json.reason = result.reason.trim();\n      item.json.escalation = result.escalation;\n    }\n  } catch (error) {\n    valid = false;\n  }\n\n  item.json.classification_valid = valid;\n\n  if (!valid) {\n    item.json.lead_score = \"unknown\";\n    item.json.reason =\n      \"AI output invalid; manual review required\";\n    item.json.escalation = false;\n  }\n}\n\nreturn items;"
      },
